# Copy to .env for defaults, or .env.local for local dev only (gitignored).
# Production builds use .env.production (committed) — do NOT put localhost in .env.production.

# Local development (.env.local — overrides .env when running npm run dev)
# VITE_API_URL=http://localhost:3000/api

# Production API (also in .env.production)
VITE_API_URL=https://millenium-digital-erp-ufio.onrender.com/api

# Frontend base URL (Admin + HR live on the same host; HR uses /login/hr and /hr/dashboard)
VITE_HR_URL=https://admin.millenium.co.ke
