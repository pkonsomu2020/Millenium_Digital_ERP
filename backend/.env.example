# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Optional: for npm run apply:migration:007 (Supabase → Database → Connection string → URI)
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# Resend Email
RESEND_API_KEY=your_resend_api_key
FROM_EMAIL=noreply@millenium.co.ke

# Server
PORT=3000
NODE_ENV=production

# Frontend URLs (for CORS) - both on same custom domain
# Same host for Admin (/login/admin) and HR (/login/hr)
FRONTEND_URL=https://admin.millenium.co.ke
HR_FRONTEND_URL=https://admin.millenium.co.ke
